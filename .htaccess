# Caché y compresión (Apache). En Netlify / Cloudflare Pages, lo mismo está en _headers. Ver PENDIENTES.md → Hosting.
#   assets/: 1 año, immutable (si se sustituye un archivo, hay que cambiarle el nombre). HTML, CSS y JS: se revalidan.

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType model/gltf-binary .glb
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

# compresión: brotli si está, si no gzip (texto, SVG, el GLB)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json model/gltf-binary
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json model/gltf-binary
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# todo lo de assets/: un año, immutable
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(.*/)?assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

ErrorDocument 404 /404.html
